{
  "name": "games",
  "description": "Collection Expo React Native de jeux classiques jouables sur mobile et sur le web: dames, échecs, backgammon, dominos, solitaire et Dino Run.",
  "main": "index",
  "version": "1.5.5",
  "license": "GPL-3.0-only",
  "dependencies": {
    "@expo/ui": "~58.0.25",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/react-native-skia": "2.14.0",
    "chess.js": "^1.4.0",
    "expo": "~58.0.21",
    "expo-asset": "~58.0.19",
    "expo-audio": "~58.0.10",
    "expo-constants": "~58.0.14",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.28",
    "expo-screen-orientation": "~58.0.3",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-import-resolver-typescript": "^3.10.1",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "uuid": "11.1.1"
  },
  "scripts": {
    "start": "expo start",
    "assets:game": "node ./scripts/generate-game-assets.mjs",
    "assets:street-brawl": "node ./scripts/generate-street-brawl-assets.mjs",
    "assets:tic-tac-toe": "node ./scripts/generate-tic-tac-toe-assets.mjs",
    "assets:connect-four": "node ./scripts/generate-connect-four-assets.mjs",
    "assets:tarot": "node ./scripts/generate-tarot-assets.mjs",
    "postinstall": "setup-skia-web public",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web",
    "lint": "expo lint",
    "test": "node --import ./scripts/test-register.mjs --test \"src/**/*.test.ts\""
  },
  "private": true
}
